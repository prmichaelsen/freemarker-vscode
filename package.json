{
  "name": "freemarker-vscode",
  "displayName": "Free Marker VS Code",
  "description": "Language support for FreeMarker",
  "author": "prmichaelsen",
  "version": "0.1.5",
  "repository": {
    "url": "https://github.com/prmichaelsen/freemarker-vscode",
    "type": "git"
  },
  "publisher": "prmichaelsen",
  "contributors": [
    "prmichaelsen"
  ],
  "categories": [],
  "keywords": [],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onFileSystem:ftl",
    "onStartupFinished"
  ],
  "extensionDependencies": [],
  "icon": "images/free_marker_dark.png",
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ftl",
        "icon": {
          "light": "images/free_marker_light.png",
          "dark": "images/free_marker_dark.png"
        },
        "aliases": [
          "FreeMarker",
          "freemarker"
        ],
        "extensions": [
          ".ftl"
        ],
        "configuration": "./ftl.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ftl",
        "scopeName": "text.html.ftl",
        "path": "./syntaxes/ftl.tmLanguage.xml"
      }
    ],
    "snippets": [
      {
        "language": "ftl",
        "path": "./snippets/ftl.json"
      },
      {
        "language": "ftl",
        "path": "./snippets/html.json"
      }
    ],
    "commands": [
      {
        "command": "freemarker-vscode.addFile",
        "title": "FreeMarker: Add file"
      },
      {
        "command": "freemarker-vscode.debugParser",
        "title": "FreeMarker: Debug parser"
      },
      {
        "command": "freemarker-vscode.checkForUpdates",
        "title": "FreeMarker: Check for updates"
      }
    ],
    "configuration": {
      "title": "FreeMarker",
      "properties": {
        "freemarker-vscode.watcher": {
          "type": "boolean",
          "default": true,
          "description": "Enable the file watcher. Required for \"Go to Reference\" and \"Test Explorer\"."
        },
        "freemarker-vscode.go-to-reference": {
          "type": "boolean",
          "default": true,
          "description": "Enable the \"Go to Reference\" feature. Requires watcher."
        },
        "freemarker-vscode.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable the diagnostics feature."
        },
        "freemarker-vscode.go-to-implementations": {
          "type": "boolean",
          "default": true,
          "description": "Enable the \"Go to Implementations\" feature."
        },
        "freemarker-vscode.semantic-tokens": {
          "type": "boolean",
          "default": true,
          "description": "Enable the semantic token highlighting."
        },
        "freemarker-vscode.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable telemetry."
        }
      }
    }
  },
  "scripts": {
    "release": "sh ./scripts/release.sh",
    "vscode:prepublish": "npm run test && npm run compile && (test \"$SKIP_INTEG\" = \"1\" && echo 'SKIP_INTEG=1 — skipping integration tests' || npm run integ)",
    "package": "yes | vsce package --out release",
    "debug": "npm run ts-node -- -r ts-node/register",
    "ts-node": "ts-node",
    "compile": "tsc -b",
    "compileInteg": "npm --prefix integration run compile",
    "e2e": "sh ./scripts/e2e.sh",
    "integ": "npm run compileInteg && npm run e2e",
    "watch": "tsc -b -w",
    "lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "test": "npm --prefix server test",
    "test:unit": "npm --prefix server run test:unit",
    "test:integration": "npm run integ",
    "getPackageVersion": "cat package.json | jq '.version' | tr -d '\"'",
    "getChangeLogVersion": "grep -oE '\\[v[0-9]+\\.[0-9]+\\.[0-9]+\\]' CHANGELOG.md | head -1 | tr -d '[v' | tr -d ']'",
    "isVersionSynced": "[[ $(npm run --silent getPackageVersion) == $(npm run --silent getChangeLogVersion) ]]",
    "isGitIndexClean": "git diff-files --quiet && git diff-index --cached --quiet HEAD --",
    "isBranchMainline": "[[ $(git rev-parse --abbrev-ref HEAD) == 'mainline' ]]",
    "isPublishReady": "npm run isVersionSynced && npm run isBranchMainline && npm run isGitIndexClean"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.14.6",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.27.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "aws-sdk": "^2.1691.0"
  }
}
